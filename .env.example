# Somente para a edição Node.js. Copie para .env (ignorado pelo Git).
# Nunca use prefixo VITE_ para senhas, tokens ou credenciais administrativas.
# Firebase Hosting fornece seus identificadores públicos em /__/firebase/init.json.
# A edição Firebase não usa credenciais administrativas no navegador.
APP_URL="http://localhost:3000"

# Banco local: não defina SQL_HOST. Dados persistem em ./data por padrão.
# PATRITI_DATA_DIR="./data"
# JWT_SECRET="gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres"
# PORT=3000
# TRUST_PROXY=1 # Somente quando há um proxy confiável à frente do servidor.

# PostgreSQL externo (opcional)
# SQL_HOST="localhost"
# SQL_PORT=5432
# SQL_USER="patriti"
# SQL_PASSWORD=""
# SQL_DB_NAME="patriti"
# SQL_ADMIN_USER=""
# SQL_ADMIN_PASSWORD=""

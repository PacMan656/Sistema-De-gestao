{
  "name": "patriti",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "start": "node --import tsx scripts/start.mjs",
    "build": "vite build",
    "build:pages": "vite build --mode pages",
    "preview:pages": "vite preview --mode pages --host 127.0.0.1",
    "preview": "npm run start",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:push": "drizzle-kit push --config src/db/drizzle.config.ts",
    "build:firebase": "vite build --mode firebase",
    "firebase:prepare": "node scripts/prepare-firebase.mjs",
    "test:rules": "node scripts/firebase-safe.mjs emulators:exec --project demo-patriti --only firestore \"node --import tsx --test tests/firebaseRules.rules.ts\"",
    "security:check": "node scripts/check-secrets.mjs",
    "security:build": "node scripts/check-secrets.mjs --dist",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:pack": "electron-builder --config desktop/builder.cjs --win portable --publish never",
    "firebase": "node scripts/firebase-safe.mjs",
    "desktop:smoke": "node scripts/smoke-desktop.mjs",
    "test:firebase": "node scripts/firebase-safe.mjs emulators:exec --project demo-patriti --only firestore,auth \"node scripts/test-firebase-api.mjs\""
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@hookform/resolvers": "^7.0.7",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.92.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.0",
    "firebase-tools": "^15.36.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "drizzle-kit": "^0.31.11",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1"
  },
  "description": "Invent?rio de TI e helpdesk por setor",
  "author": "Equipe PatriTI",
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "@firebase/app": "0.16.7",
    "@firebase/app-compat": "0.5.23"
  }
}
